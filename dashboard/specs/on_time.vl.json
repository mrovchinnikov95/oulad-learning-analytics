{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Доля заданий TMA, сданных в день срока или раньше, среди сданных, по потокам.",
  "data": {
    "url": "data/presentation_outcome.json"
  },
  "transform": [
    {
      "calculate": "datum.code_module + ' ' + datum.code_presentation",
      "as": "presentation"
    }
  ],
  "width": "container",
  "height": {
    "step": 20
  },
  "mark": {
    "type": "bar",
    "color": "token:muted",
    "height": {
      "band": 0.6
    },
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "presentation",
      "type": "nominal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "tma_on_time_share",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "format": ".0%",
        "tickCount": 5
      }
    },
    "tooltip": [
      {
        "field": "presentation",
        "title": "Поток"
      },
      {
        "field": "tma_on_time",
        "title": "Сдано в срок",
        "format": ",d"
      },
      {
        "field": "tma_submitted",
        "title": "Сдано TMA",
        "format": ",d"
      },
      {
        "field": "tma_on_time_share",
        "title": "Доля в срок",
        "format": ".1%"
      }
    ]
  }
}
