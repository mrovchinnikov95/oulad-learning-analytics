{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Доля сдавших каждое задание TMA/CMA среди тех, кто должен был сдать, по порядку заданий. Источник: mart.assessment_submission.",
  "title": {"text": "Сдача заданий по порядку", "subtitle": "Доля сдавших среди тех, кто числился на курсе в день срока; задания TMA и CMA"},
  "data": {"url": "data/assessment_submission.json"},
  "transform": [
    {"calculate": "datum.code_module + ' ' + datum.code_presentation", "as": "presentation"},
    {"calculate": "slice(datum.code_presentation, 4) == 'B' ? 'февраль' : 'октябрь'", "as": "month"},
    {"calculate": "slice(datum.code_presentation, 0, 4)", "as": "year"}
  ],
  "facet": {"field": "code_module", "type": "nominal", "title": null, "header": {"labelFontSize": 12, "labelFontWeight": 600, "labelPadding": 4}},
  "columns": 4,
  "spacing": {"row": 16, "column": 16},
  "spec": {
    "width": 200,
    "height": 130,
    "layer": [
      {"mark": {"type": "line", "strokeWidth": 2, "interpolate": "monotone"},
       "encoding": {
         "x": {"field": "seq", "type": "quantitative", "title": "задание №", "axis": {"tickMinStep": 1, "format": "d"}},
         "y": {"field": "submission_rate", "type": "quantitative", "title": null,
               "scale": {"domain": [0.4, 1]}, "axis": {"format": ".0%", "tickCount": 4}},
         "color": {"field": "month", "type": "nominal", "title": "Старт",
                   "scale": {"domain": ["октябрь", "февраль"], "range": ["token:oct", "token:feb"]}},
         "strokeDash": {"field": "year", "type": "nominal", "title": "Год",
                        "scale": {"domain": ["2013", "2014"], "range": [[1, 0], [5, 3]]}},
         "detail": {"field": "presentation"}}},
      {"mark": {"type": "point", "filled": true, "size": 64, "opacity": 0},
       "encoding": {
         "x": {"field": "seq", "type": "quantitative"},
         "y": {"field": "submission_rate", "type": "quantitative"},
         "tooltip": [
           {"field": "presentation", "title": "Поток"},
           {"field": "seq", "title": "Задание №"},
           {"field": "assessment_type", "title": "Тип"},
           {"field": "deadline_day", "title": "Срок, день"},
           {"field": "expected", "title": "Должны сдать", "format": ",d"},
           {"field": "submitted", "title": "Сдали", "format": ",d"},
           {"field": "submission_rate", "title": "Доля", "format": ".1%"}
         ]}}
    ]
  }
}
